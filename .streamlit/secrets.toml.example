# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets.
# NEVER commit the real secrets.toml.

# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION POOLER (port 5432) or TRANSACTION POOLER (port 6543) host.
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Anyone with this code can join the league. Leave blank to allow open signup.
LEAGUE_INVITE_CODE = "roll-tide-2026"
